# ---------------------------------------------------------------------------
# BatchLens configuration. Copy to `.env` and fill in. API keys are read
# server-side only; never prefix them with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# SQLite file (relative to the project root). For Postgres see README.
DATABASE_URL="file:./dev.db"

# Root folder for originals, AI intermediates, edited outputs and previews.
STORAGE_DIR="./storage"

# Main AI image-edit provider: "openai" | "mock"
#   mock  = tints the input after a 1–3 s delay and fails ~10% of the time (no spend)
IMAGE_PROVIDER="mock"
IMAGE_PROVIDER_API_KEY=""
# Model id for the provider, e.g. gpt-image-2 (OpenAI). Check the provider's
# current model list — model ids are never hard-coded in the app.
IMAGE_PROVIDER_MODEL="gpt-image-2"
# Optional OpenAI image-edit tuning (see README → Providers)
# OPENAI_IMAGE_QUALITY="high"          # low | medium | high | auto (newer models also xhigh|max)
# OPENAI_INPUT_FIDELITY=""             # "high" only for models that support it (gpt-image-1.5); leave empty for gpt-image-2

# Dedicated background-removal provider used when the ONLY AI edit is
# "Background → pure white": "photoroom" | "removebg" | "" (disabled)
# If the key is empty the main IMAGE_PROVIDER is used instead.
BG_REMOVAL_PROVIDER=""
BG_REMOVAL_API_KEY=""

# Vision QC (Anthropic Messages API). With no key, QC uses the mock checker
# when IMAGE_PROVIDER=mock and is skipped otherwise.
ANTHROPIC_API_KEY=""
ANTHROPIC_QC_MODEL="claude-opus-5-5"

# Cost estimates shown in the UI (integer cents per call). Set these from the
# providers' current pricing pages — the defaults are placeholders.
AI_COST_PER_CALL_CENTS="8"
BG_REMOVAL_COST_PER_CALL_CENTS="2"

# Worker / queue tuning (Settings page values override the first two)
MAX_CONCURRENT_AI_CALLS="3"
MAX_RETRIES="2"
MAX_UPLOAD_MB="25"

# Set to "true" to run the queue worker inside the Next.js server process
# (via instrumentation.ts) instead of a separate `npm run worker`.
RUN_WORKER_IN_APP="false"
