// BatchLens data model.
// Switching to Postgres: change `provider` below to "postgresql", swap the
// driver adapter in lib/db.ts (@prisma/adapter-pg), and re-run migrations.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum BatchStatus {
  DRAFT
  READY
  PROCESSING
  PAUSED
  REVIEW
  COMPLETE
  CANCELLED
}

enum ImageStatus {
  QUEUED
  PROCESSING_AI
  PROCESSING_STANDARD
  DONE
  FAILED
  APPROVED
  REJECTED
}

enum ViewAngle {
  SIDE
  FRONT
  BACK
  TOP
  SOLE
  PAIR
  DETAIL
  LIFESTYLE
  OTHER
}

enum PresetCategory {
  ECOMMERCE
  WHOLESALE
  SOCIAL
  WEB
  CUSTOM
}

model Batch {
  id                 String        @id @default(cuid())
  name               String
  description        String?
  brand              String
  status             BatchStatus   @default(DRAFT)
  presetId           String?
  preset             Preset?       @relation(fields: [presetId], references: [id], onDelete: SetNull)
  /// Working EditSettings while the batch is being configured (not frozen)
  settings           Json?
  /// Frozen copy of EditSettings taken when processing starts
  settingsSnapshot   Json?
  totalImages        Int           @default(0)
  completedCount     Int           @default(0)
  failedCount        Int           @default(0)
  approvedCount      Int           @default(0)
  rejectedCount      Int           @default(0)
  aiCallsUsed        Int           @default(0)
  estimatedCostCents Int?
  /// JSON array of strings (SQLite has no array type)
  tags               String        @default("[]")
  startedAt          DateTime?
  finishedAt         DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  images             BatchImage[]
  logs               ActivityLog[]

  @@index([status])
  @@index([createdAt])
}

model BatchImage {
  id                  String         @id @default(cuid())
  batchId             String
  batch               Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  sortOrder           Int
  originalKey         String
  originalFilename    String
  originalWidth       Int
  originalHeight      Int
  originalSizeKb      Int
  originalMime        String
  aiIntermediateKey   String?
  aiSettingsHash      String?
  editedKey           String?
  outputFilename      String?
  outputWidth         Int?
  outputHeight        Int?
  outputSizeKb        Int?
  status              ImageStatus    @default(QUEUED)
  errorMessage        String?
  retryCount          Int            @default(0)
  lockedAt            DateTime?
  /// Earliest time the worker may (re)claim this image — used for retry backoff
  availableAt         DateTime?
  /// What the next processing run should do: FULL (AI + standard) or STANDARD (standard only)
  jobKind             String         @default("FULL")
  perImageInstruction String?
  useOriginal         Boolean        @default(false)
  qcScore             Int?
  /// JSON array of strings
  qcIssues            String?
  qcVerdict           String?
  styleCode           String?
  colorName           String?
  viewAngle           ViewAngle?
  versions            ImageVersion[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([batchId, sortOrder])
  @@index([status, lockedAt])
}

model ImageVersion {
  id                String     @id @default(cuid())
  imageId           String
  image             BatchImage @relation(fields: [imageId], references: [id], onDelete: Cascade)
  aiIntermediateKey String?
  aiSettingsHash    String?
  editedKey         String
  outputWidth       Int?
  outputHeight      Int?
  outputSizeKb      Int?
  instruction       String?
  qcScore           Int?
  createdAt         DateTime   @default(now())

  @@index([imageId])
}

model Preset {
  id          String         @id @default(cuid())
  name        String         @unique
  description String?
  category    PresetCategory @default(CUSTOM)
  settings    Json
  isDefault   Boolean        @default(false)
  usageCount  Int            @default(0)
  exampleKey  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  batches     Batch[]
}

model ActivityLog {
  id        String   @id @default(cuid())
  batchId   String?
  batch     Batch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)
  action    String
  details   String?
  createdAt DateTime @default(now())

  @@index([batchId])
  @@index([createdAt])
}

model AppSettings {
  id                   String  @id @default("singleton")
  defaultPresetId      String?
  maxConcurrentAiCalls Int     @default(3)
  maxRetries           Int     @default(2)
  autoQcEnabled        Boolean @default(true)
  qcThreshold          Int     @default(70)
  /// JSON array of brand names
  brandList            String  @default("[\"Chelsea Crew\",\"Amie Rafa\",\"Other\"]")
  defaultNamingPattern String  @default("{style}_{color}_{view}")
  /// JSON array of {id, name, key}
  watermarkLibrary     String  @default("[]")
}
